# =====================================================
# DezTehYug CRM — переменные окружения (шаблон)
# =====================================================
# Скопируй в .env.local для локальной разработки
# На проде эти значения подставляются через docker-compose.prod.yml

# ---- БД (Postgres) ----
DATABASE_URL=postgresql://deztech:dev_password_change_me@localhost:5432/deztech_crm

# ---- Auth.js v5 ----
# Генерация: openssl rand -base64 32
AUTH_SECRET=replace_me_with_long_random_string_min_32_chars
# В dev: http://localhost:3000, в prod: https://crm.дезтехюг.рф
AUTH_URL=http://localhost:3000

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- File storage (Sprint 3 — local на dev и prod, S3 потом) ----
# Драйвер: local (файлы на диске) | s3 (Yandex Object Storage, не реализован)
STORAGE_DRIVER=local
# Корень для local-драйвера. На dev — ./storage, на prod — /opt/deztech-crm/storage
STORAGE_ROOT=./storage

# ---- S3 (Yandex Object Storage — план Sprint 4+, переменные зарезервированы) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=deztech_minio
S3_SECRET_ACCESS_KEY=dev_minio_password_123
S3_BUCKET=deztechyug-crm
# В Yandex S3 forcePathStyle=true обязателен
S3_FORCE_PATH_STYLE=true

# ---- Mailer (Sprint 3) ----
# Транспорт: smtp (реальная отправка) | noop (только лог, для prod пока нет SMTP Beget)
MAILER_TRANSPORT=smtp

# ---- SMTP (MailHog локально, Beget mail в проде) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DezTehYug CRM <noreply@deztechyug.ru>"

# ---- Telegram-бот (для уведомлений) ----
# Токен от @BotFather, заполнится позже на Этапе 8
TELEGRAM_BOT_TOKEN=

# ---- LibreOffice конвертер (DOCX → PDF) ----
# В dev можно запускать без отдельного контейнера, в prod через сервис
LIBREOFFICE_URL=http://localhost:2004

# ---- n8n integration ----
# Webhook secret для проверки входящих заявок
N8N_INBOUND_SECRET=generate_random_long_string_for_lead_inbound

# ---- Public ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DezTehYug CRM
