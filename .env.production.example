# =====================================================
# DezTehYug CRM — production переменные (для VPS)
# =====================================================
# Размещается на VPS как /opt/deztech-crm/.env
# Никогда не коммитить в git!

# ---- Домен ----
# Кириллический и Punycode варианты — нужны оба для SSL
DOMAIN=crm.дезтехюг.рф
DOMAIN_PUNYCODE=crm.xn--c1abdaj0ewa6e.xn--p1ai

# ---- Auth.js ----
# Сгенерируй: openssl rand -base64 32
AUTH_SECRET=GENERATE_LONG_RANDOM_STRING_HERE_MIN_32_CHARS
AUTH_URL=https://crm.дезтехюг.рф

# ---- Postgres ----
POSTGRES_DB=deztech_crm
POSTGRES_USER=deztech
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# ---- Let's Encrypt ----
ACME_EMAIL=sanctumizm@gmail.com

# ---- File storage (Sprint 3 — local) ----
# На prod храним в named volume `app-storage`, монтируется в /app/storage
STORAGE_DRIVER=local
STORAGE_ROOT=/app/storage

# ---- Yandex Object Storage (зарезервировано на Sprint 4+, не используется пока) ----
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=deztechyug-crm

# ---- Mailer (Sprint 3) ----
# Транспорт: smtp — реальная отправка | noop — лог (если SMTP ещё не настроен)
# После настройки Yandex 360 — выставить smtp без передеплоя кода.
MAILER_TRANSPORT=noop

# ---- SMTP (Yandex 360 — у домена дезтехюг.рф уже настроены MX/DKIM/SPF) ----
# Создание пароля приложения: id.yandex.ru → Безопасность → Пароли приложений →
#   "Почта" → создаст 16-символьный пароль (показывается один раз).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ДезТехЮг CRM <noreply@дезтехюг.рф>"

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=

# ---- n8n integration ----
# Этот секрет n8n должен слать в заголовке X-N8N-Secret для аутентификации заявок
N8N_INBOUND_SECRET=GENERATE_RANDOM_STRING_FOR_N8N
